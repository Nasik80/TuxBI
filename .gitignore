# ============================================================
# TuxBI Git Ignore
# ============================================================

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build outputs
dist/
build/
out/
target/

# Tauri
src-tauri/target/
src-tauri/gen/

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Coverage
coverage/
htmlcov/
.coverage

# Python distributions
*.egg-info/
*.whl

# TuxBI local data
.tuxbi-cache/
.tuxbi-temp/

# Local datasets
data/
datasets/

# Generated reports
reports/

# Docker
docker-data/

# Secrets
*.pem
*.key
*.crt
